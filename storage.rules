rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      // Only the verified owner signed in through Google may use this app.
      return request.auth != null
        && request.auth.token.email == 'mjvermeltfoort@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/meetings/{meetingId}/recordings/{segmentId} {
      allow read: if owns(uid);
      allow write: if owns(uid)
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if owns(uid);
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
